{
  "expo": {
    "name": "calendar-app",
    "slug": "calendar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calendarapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.veneratedptatoo.calendar",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "GIDClientID": "198333533430-s56q7jj007kdk6h9qs0a6gpa8h05vo3u.apps.googleusercontent.com",
        "CFBundleURLTypes": [
            {
                "CFBundleURLSchemes": [
                    "com.googleusercontent.apps.198333533430-s56q7jj007kdk6h9qs0a6gpa8h05vo3u"
                ]
            }
        ]
      }
    },
    "android": {
      "package": "com.veneratedptatoo.calendar",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "baseUrl": "/your-repository-name"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.198333533430-s56q7jj007kdk6h9qs0a6gpa8h05vo3u"
        }
      ],
      "expo-web-browser"
    ]
    
    ,
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a390a9f6-e561-4cb9-8ae3-2e4f513e6bb4"
      }
    }
  }
}
